# 모든 설정 파일이 읽는다. dev 는 기본값이 없어 비우면 기동이 실패한다.
DJANGO_SECRET_KEY=replace-with-strong-random-key

# 데이터베이스 (prod: Supabase PostgreSQL, transaction pooler)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=6543

# 메일 (prod: Gmail SMTP. dev 는 콘솔 백엔드라 비워도 된다)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
DEFAULT_FROM_EMAIL=LifeDiary <noreply@example.com>

# Google 로그인 (allauth). 비우면 소셜 로그인 버튼이 동작하지 않는다.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# 로그인 reCAPTCHA (prod 에서만 켜진다. 5회 실패 뒤 요구)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# 분석·검색 (선택. 비우면 태그가 렌더되지 않는다)
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# 운영 조정값 (선택)
AXES_FAILURE_LIMIT=1000
STATS_SERVER_TIMING_ENABLED=false
